rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isConversationMember() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }
    function validReaction() {
      return request.resource.data.keys().hasOnly(['userId', 'emoji', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.emoji in ['👍', '❤️', '😂', '🔥', '👀', '🙌'];
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'favoriteGenres', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.bio.size() <= 240
        && request.resource.data.favoriteGenres.size() <= 120;
      allow delete: if isSelf(uid);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kind in ['track', 'announcement']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 100
        && request.resource.data.description.size() <= 500;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /roomMessages/{messageId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 500;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if signedIn() && validReaction()
          && reactionId.matches(request.auth.uid + '_.*');
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
        allow update: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if isConversationMember();
      allow create: if signedIn()
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isConversationMember()
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        function parentMember() {
          return signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        }
        allow read: if parentMember();
        allow create: if parentMember()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 500;
        allow update, delete: if parentMember() && resource.data.userId == request.auth.uid;

        match /reactions/{reactionId} {
          function parentMember() {
            return signedIn() && request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
          }
          allow read: if parentMember();
          allow create: if parentMember() && validReaction()
            && reactionId.matches(request.auth.uid + '_.*');
          allow delete: if parentMember() && resource.data.userId == request.auth.uid;
          allow update: if false;
        }
      }
    }
  }
}
