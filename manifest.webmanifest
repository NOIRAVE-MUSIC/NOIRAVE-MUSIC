{
  "id": "./index.html",
  "name": "NoiRave — Community Radio",
  "short_name": "NoiRave",
  "description": "Share music and announcements, and chat with your community.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#10120f",
  "theme_color": "#ff4057",
  "categories": ["music", "social"],
  "icons": [
    { "src": "./assets/noirave-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/noirave-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "./noirave-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Open Chats", "short_name": "Chats", "url": "./chats.html" },
    { "name": "Open Settings", "short_name": "Settings", "url": "./settings.html" }
  ]
}
